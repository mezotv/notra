# Application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# AI Services
OPENROUTER_API_KEY=
SUPERMEMORY_API_KEY=
CONTEXT_DEV_API_KEY=
AI_GATEWAY_API_KEY=
TCC_API_KEY=

# AI Model Router (Vercel AI Gateway <-> OpenRouter)
# off = everything via Vercel (legacy behaviour), canary = free/no-org traffic
# goes to OpenRouter by allowlist/percentage, on = full plan-based routing.
AI_ROUTER_MODE=off
# Gateway for requests without organization context (background jobs).
AI_ROUTER_DEFAULT_GATEWAY=openrouter
AI_ROUTER_PAID_GATEWAY=vercel
AI_ROUTER_FREE_GATEWAY=openrouter
# Canary rollout: stable per-organization bucket, 0-100.
AI_ROUTER_OPENROUTER_ROLLOUT_PERCENT=0
# Comma-separated organization ids that always use OpenRouter in canary mode.
AI_ROUTER_OPENROUTER_ORG_ALLOWLIST=
# Ops kill switch: vercel|openrouter forces every request onto one gateway.
AI_ROUTER_FORCE_GATEWAY=
# Retry on the other gateway (with ZDR enforced) on outages / no credits.
AI_ROUTER_CROSS_GATEWAY_FALLBACK=true
# Development only: allow routes that do not enforce zero data retention.
AI_ROUTER_ALLOW_NON_ZDR_IN_DEVELOPMENT=false

# Encryption
INTEGRATION_ENCRYPTION_KEY=

