{
  "name": "@usenotra/geo",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Request capture SDK for AI traffic attribution",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/usenotra/notra/tree/main/packages/geo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenotra/notra.git",
    "directory": "packages/geo"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./next": "./src/next.ts",
    "./nuxt": "./src/nuxt.ts",
    "./netlify": "./src/netlify.ts",
    "./signatures": "./src/signatures.ts",
    "./classify": "./src/classify.ts",
    "./markdown": "./src/markdown.ts",
    "./html": "./src/html.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./next": {
        "types": "./dist/next.d.ts",
        "import": "./dist/next.js"
      },
      "./nuxt": {
        "types": "./dist/nuxt.d.ts",
        "import": "./dist/nuxt.js"
      },
      "./netlify": {
        "types": "./dist/netlify.d.ts",
        "import": "./dist/netlify.js"
      },
      "./signatures": {
        "types": "./dist/signatures.d.ts",
        "import": "./dist/signatures.js"
      },
      "./classify": {
        "types": "./dist/classify.d.ts",
        "import": "./dist/classify.js"
      },
      "./markdown": {
        "types": "./dist/markdown.d.ts",
        "import": "./dist/markdown.js"
      },
      "./html": {
        "types": "./dist/html.d.ts",
        "import": "./dist/html.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@notra/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "5.9.2"
  }
}
