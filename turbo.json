{
  "$schema": "https://v2-9-18.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "AI_GATEWAY_API_KEY",
    "ALLOW_UNMETERED_AI_IN_DEVELOPMENT",
    "APP_URL",
    "AUTUMN_PROD_SECRET_KEY",
    "AUTUMN_SECRET_KEY",
    "BYDEFAULT_TOKEN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "CONSOLE_BETTER_AUTH_URL",
    "DATABASE_URL",
    "CONTEXT_DEV_API_KEY",
    "GITHUB_APP_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_APP_SLUG",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_TOKEN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "INTEGRATION_ENCRYPTION_KEY",
    "OPENROUTER_API_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN",
    "QSTASH_URL",
    "QSTASH_CURRENT_SIGNING_KEY",
    "QSTASH_NEXT_SIGNING_KEY",
    "QSTASH_TOKEN",
    "RESEND_API_KEY",
    "SUPERMEMORY_API_KEY",
    "UPSTASH_REDIS_REST_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "DATABUDDY_API_KEY",
    "CLOUDFLARE_SECRET_ACCESS_KEY",
    "CLOUDFLARE_ACCESS_KEY_ID",
    "CLOUDFLARE_S3_ENDPOINT",
    "CLOUDFLARE_PUBLIC_URL",
    "CLOUDFLARE_BUCKET_NAME",
    "AI_SDK_LOG_WARNINGS",
    "DO_NOT_TRACK",
    "UNKEY_ROOT_KEY",
    "UNKEY_API_ID",
    "TWITTER_BEARER_TOKEN",
    "TWITTER_CLIENT_ID",
    "TWITTER_CLIENT_SECRET",
    "MARBLE_API_KEY",
    "MARBLE_WEBHOOK_SECRET",
    "NOTRA_API_KEY",
    "WORKFLOW_BASE_URL",
    "LINEAR_CLIENT_ID",
    "LINEAR_CLIENT_SECRET",
    "AXIOM_TOKEN",
    "AXIOM_AI_DATASET",
    "AXIOM_ORG_ID",
    "AI_SDK_DEVTOOLS",
    "AI_SDK_DEVTOOLS_PORT",
    "SKILLS_SH_API_KEY",
    "FEEDBACK_EMAIL_TO",
    "OSS_PROGRAM_EMAIL_TO",
    "UPSTASH_BOX_API_KEY",
    "VERCEL",
    "SLACK_BOT_TOKEN",
    "SLACK_FOUNDER_MEMBER_ID",
    "TCC_API_KEY",
    "EVE_ONBOARDING_AGENT_URL",
    "EVE_ONBOARDING_AGENT_PASSWORD",
    "DASHBOARD_VERCEL_TEAM_SLUG",
    "DASHBOARD_VERCEL_PROJECT_NAME",
    "DASHBOARD_VERCEL_ENVIRONMENT"
  ],
  "envMode": "strict",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", ".vercel/**"]
    },
    "@notra/onboarding-agent#build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", ".eve/compile/**", ".eve/discovery/**"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "knip": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
